NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# Supabase Postgres connection string.
# Use the transaction/session pooler URL recommended by Supabase for serverless
# runtimes, or the direct database URL if you deploy a long-lived Cloud Run service.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres?schema=jitu_backend&sslmode=require

# Public URLs
FRONTEND_URL=https://YOUR_VERCEL_DOMAIN
BETTER_AUTH_URL=https://YOUR_VERCEL_DOMAIN
BETTER_AUTH_SECRET=replace-with-strong-random-secret

# CORS / auth trusted origins
ALLOWED_ORIGINS=https://YOUR_VERCEL_DOMAIN
TRUSTED_ORIGINS=https://YOUR_VERCEL_DOMAIN

# Google OAuth
# Add https://YOUR_VERCEL_DOMAIN/api/auth/callback/google as an authorized redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary
CLOUDINARY_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="Jitu Team <no-reply@jitu.com>"

# Midtrans
MERCHANT_ID=
CLIENT_KEY=
SERVER_KEY=

# Internal AI service
AI_SERVICE_URL=https://YOUR_AI_SERVICE_CLOUD_RUN_URL
AI_SERVICE_INTERNAL_API_KEY=replace-with-shared-internal-key

# Production AI service should use AI_PROVIDER=openai.
