NODE_ENV=production
PORT=10000
HOST=0.0.0.0

# Supabase Postgres connection string.
# Use the direct Supabase URL or the session pooler URL for Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres?schema=jitu_backend&sslmode=require

# Public URLs
FRONTEND_URL=https://YOUR_VERCEL_DOMAIN

# CORS
ALLOWED_ORIGINS=https://YOUR_VERCEL_DOMAIN

# Firebase Admin SDK project used to verify Firebase Auth ID tokens.
FIREBASE_PROJECT_ID=jitu-ptn-main-auth-2026

# Cloudinary
CLOUDINARY_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Midtrans
MERCHANT_ID=
CLIENT_KEY=
SERVER_KEY=

# Internal AI service
AI_SERVICE_URL=https://YOUR_AI_SERVICE_URL
AI_SERVICE_INTERNAL_API_KEY=replace-with-shared-internal-key

# Production AI service should use AI_PROVIDER=openai.
